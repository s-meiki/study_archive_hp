  "regex": [
    {"pattern": "[「」『』()（）\"]", "replace": ""},
    {"pattern": "・", "replace": "、"},
    {"pattern": "〜", "replace": "から"},
    {"pattern": "→", "replace": "、"},
    {"pattern": "◯", "replace": "まる"},
    {"pattern": "[ \\t]+", "replace": ""},
    {"pattern": "\n{3,}", "replace": "\n\n"}
  ]
